{
  "name": "kg-protocol-detect",
  "version": "0.1.0",
  "description": "Sniff which Kinetic Gain Suite spec (agent-cards / mcp-tool-card / prompt-provenance / evidence-bundle) — or OTel GenAI OTLP envelope, or MCP tools/list — a JSON document represents. Returns {protocol, version, confidence, reason}. Composes with every governance pipeline as a routing primitive.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/kg-protocol-detect"
  },
  "keywords": [
    "protocol",
    "detection",
    "ai-governance",
    "kinetic-gain-suite",
    "agent-cards",
    "mcp",
    "provenance",
    "evidence",
    "typescript"
  ],
  "bin": {
    "kg-protocol-detect": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts fixtures/agent-card.json --json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
